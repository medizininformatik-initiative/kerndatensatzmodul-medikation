         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "duration SHALL be a non-negative value" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "duration.exists() implies duration >= 0" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "f:duration/@value >= 0 or not(f:duration/@value)" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Timing" ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Timing>
         ]
