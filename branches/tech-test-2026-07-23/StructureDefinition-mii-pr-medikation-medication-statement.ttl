         ]
       ], [
         fhir:index 5 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "tim-6" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "If there's a periodMax, there must be a period" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "periodMax.empty() or period.exists()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "not(exists(f:periodMax)) or exists(f:period)" ] ;
