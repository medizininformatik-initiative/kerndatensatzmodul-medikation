         fhir:ElementDefinition.constraint.human [ fhir:value "if there's a period, there needs to be period units" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "period.empty() or periodUnit.exists()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "not(exists(f:period)) or exists(f:periodUnit)" ] ;
         fhir:ElementDefinition.constraint.source [
