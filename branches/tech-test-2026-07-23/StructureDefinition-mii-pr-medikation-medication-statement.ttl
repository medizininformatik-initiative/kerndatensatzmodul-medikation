         fhir:ElementDefinition.constraint.key [ fhir:value "tim-5" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "period SHALL be a non-negative value" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "period.exists() implies period >= 0" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "f:period/@value >= 0 or not(f:period/@value)" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Timing" ;
