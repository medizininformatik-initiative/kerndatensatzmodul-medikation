         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "if there's a duration, there needs to be duration units" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "duration.empty() or durationUnit.exists()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "not(exists(f:duration)) or exists(f:durationUnit)" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Timing" ;
