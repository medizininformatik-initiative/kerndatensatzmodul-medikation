           fhir:link <http://hl7.org/fhir/StructureDefinition/Timing>
         ]
       ], [
         fhir:index 7 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "tim-8" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "If there's a countMax, there must be a count" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "countMax.empty() or count.exists()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "not(exists(f:countMax)) or exists(f:count)" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Timing" ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Timing>
         ]
       ], [
         fhir:index 8 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "tim-9" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "If there's an offset, there must be a when (and not C, CM, CD, CV)" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "offset.empty() or (when.exists() and ((when in ('C' | 'CM' | 'CD' | 'CV')).not()))" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "not(exists(f:offset)) or exists(f:when)" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Timing" ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Timing>
         ]
       ], [
         fhir:index 9 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "tim-10" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "If there's a timeOfDay, there cannot be a when, or vice versa" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "timeOfDay.empty() or when.empty()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "not(exists(f:timeOfDay)) or not(exists(f:when))" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Timing" ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Timing>
         ]
       ], [
         fhir:index 10 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "TimingSingleDosageForTimeOfDay" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Wenn nur timeOfDay verwendet wird und täglich dosiert wird, ist die Angabe in einem einzigen Dosage-Element zu modellieren. Mehrere Dosage-Elemente sind nur zulässig, wenn sich die Dosis (Wert) unterscheidet." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "(\n  %resource.ofType(MedicationRequest).dosageInstruction\n  | %resource.ofType(MedicationDispense).dosageInstruction\n  | %resource.ofType(MedicationStatement).dosage\n).all(\n  (\n    timing.repeat.dayOfWeek.empty() and\n    timing.repeat.timeOfDay.exists() and\n    timing.repeat.when.empty() and\n    (timing.repeat.period.exists() and timing.repeat.period = 1) and\n    (timing.repeat.periodUnit.exists() and timing.repeat.periodUnit = 'd')\n  )\n  implies\n  (\n    (\n      (\n        %resource.ofType(MedicationRequest).dosageInstruction\n        | %resource.ofType(MedicationDispense).dosageInstruction\n        | %resource.ofType(MedicationStatement).dosage\n      ).where(\n        timing.repeat.dayOfWeek.empty() and timing.repeat.timeOfDay.exists() and timing.repeat.when.empty() and (timing.repeat.period.exists() and timing.repeat.period = 1) and (timing.repeat.periodUnit.exists() and timing.repeat.periodUnit = 'd')\n      ).count() = 1\n    )\n    or\n    (\n      (\n        %resource.ofType(MedicationRequest).dosageInstruction\n        | %resource.ofType(MedicationDispense).dosageInstruction\n        | %resource.ofType(MedicationStatement).dosage\n      ).where(\n        timing.repeat.dayOfWeek.empty() and timing.repeat.timeOfDay.exists() and timing.repeat.when.empty() and (timing.repeat.period.exists() and timing.repeat.period = 1) and (timing.repeat.periodUnit.exists() and timing.repeat.periodUnit = 'd')\n      ).doseAndRate.dose.ofType(Quantity).value.distinct().count() > 1\n    )\n  )\n)" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://ig.fhir.de/igs/medication/StructureDefinition/TimingDE" ;
           fhir:link <http://ig.fhir.de/igs/medication/StructureDefinition/TimingDE>
         ]
       ], [
         fhir:index 11 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "TimingSingleDosageForWhen" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Wenn nur when verwendet wird und täglich dosiert wird, ist die Angabe in einem einzigen Dosage-Element zu modellieren. Mehrere Dosage-Elemente sind nur zulässig, wenn sich die Dosis (Wert) unterscheidet." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "(\n  %resource.ofType(MedicationRequest).dosageInstruction\n  | %resource.ofType(MedicationDispense).dosageInstruction\n  | %resource.ofType(MedicationStatement).dosage\n).all(\n  (\n    timing.repeat.dayOfWeek.empty() and\n    timing.repeat.when.exists() and\n    timing.repeat.timeOfDay.empty() and\n    (timing.repeat.period.exists() and timing.repeat.period = 1) and\n    (timing.repeat.periodUnit.exists() and timing.repeat.periodUnit = 'd')\n  )\n  implies\n  (\n    (\n      (\n        %resource.ofType(MedicationRequest).dosageInstruction\n        | %resource.ofType(MedicationDispense).dosageInstruction\n        | %resource.ofType(MedicationStatement).dosage\n      ).where(\n        timing.repeat.dayOfWeek.empty() and timing.repeat.when.exists() and timing.repeat.timeOfDay.empty() and (timing.repeat.period.exists() and timing.repeat.period = 1) and (timing.repeat.periodUnit.exists() and timing.repeat.periodUnit = 'd')\n      ).count() = 1\n    )\n    or\n    (\n      (\n        %resource.ofType(MedicationRequest).dosageInstruction\n        | %resource.ofType(MedicationDispense).dosageInstruction\n        | %resource.ofType(MedicationStatement).dosage\n      ).where(\n        timing.repeat.dayOfWeek.empty() and timing.repeat.when.exists() and timing.repeat.timeOfDay.empty() and (timing.repeat.period.exists() and timing.repeat.period = 1) and (timing.repeat.periodUnit.exists() and timing.repeat.periodUnit = 'd')\n      ).doseAndRate.dose.ofType(Quantity).value.distinct().count() > 1\n    )\n  )\n)" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://ig.fhir.de/igs/medication/StructureDefinition/TimingDE" ;
           fhir:link <http://ig.fhir.de/igs/medication/StructureDefinition/TimingDE>
         ]
       ], [
         fhir:index 12 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "TimingBoundsUnitMatchesCode" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "boundsDuration.unit muss zur UCUM boundsDuration.code passen (z. B. 'Woche(n)' nur mit code='wk')." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "bounds.ofType(Duration).exists().not() or (\n  (\n    bounds.ofType(Duration).code = 'd'\n    implies \n    (\n      bounds.ofType(Duration).unit = 'Tag(e)' or\n      bounds.ofType(Duration).unit = 'Tag' or\n      bounds.ofType(Duration).unit = 'Tage'\n    )\n  ) and (\n    bounds.ofType(Duration).code = 'wk'\n    implies \n    (\n      bounds.ofType(Duration).unit = 'Woche(n)' or\n      bounds.ofType(Duration).unit = 'Woche' or\n      bounds.ofType(Duration).unit = 'Wochen'\n    )\n  ) and (\n    bounds.ofType(Duration).code = 'mo'\n    implies \n    (\n      bounds.ofType(Duration).unit = 'Monat(e)' or\n      bounds.ofType(Duration).unit = 'Monat' or\n      bounds.ofType(Duration).unit = 'Monate'\n    )\n  ) and (\n    bounds.ofType(Duration).code = 'a'\n    implies \n    (\n      bounds.ofType(Duration).unit = 'Jahr(e)' or\n      bounds.ofType(Duration).unit = 'Jahr' or\n      bounds.ofType(Duration).unit = 'Jahre'\n    )\n  )\n)" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://ig.fhir.de/igs/medication/StructureDefinition/TimingDE" ;
