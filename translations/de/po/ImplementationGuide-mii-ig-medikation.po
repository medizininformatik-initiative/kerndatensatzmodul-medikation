# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "MII CPS Medikation CapabilityStatement"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Das vorliegende CapabilityStatement beschreibt alle verpflichtenden Interaktionen die ein konformes System unterstützen muss, um das Modul Medikation der Medizininformatik Initiative zu implementieren."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "MII CS Medikation Wirkstofftyp"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Codes zur Differenzierung von Wirkstoffen zwischen genauer Substanz (z.B. Salz, Ester etc.), allgemeiner (normalisierter) Substanz und Kombinationscode für mehrere Wirkstoffe."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "MII EX Medikation Wirkstoffrelation"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Die Extension ermöglicht die Zuordnung von einem genauem Wirkstoff (z.B. Salz, Ester) zu einem allgemeinem Wirkstoff."
msgstr ""

# ImplementationGuide.definition.resource.name
#: ImplementationGuide.definition.resource.name
msgid "MII EX Medikation Wirkstofftyp"
msgstr ""

# ImplementationGuide.definition.resource.description
#: ImplementationGuide.definition.resource.description
msgid "Extension zur Differenzierung des Wirkstofftyps in allgemeinen, genauen oder Kombinationswirkstoff."
msgstr ""

