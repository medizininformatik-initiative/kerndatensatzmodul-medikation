      <trans-unit id="ImplementationGuide-mii-ig-medikation" resname="ImplementationGuide.definition.resource.description">
             <notes>
               <note id="n1">ImplementationGuide.definition.resource.description</note>
             </notes>
        <source>Das vorliegende CapabilityStatement beschreibt alle verpflichtenden Interaktionen die ein konformes System unterstützen muss, um das Modul Medikation der Medizininformatik Initiative zu implementieren.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="ImplementationGuide-mii-ig-medikation" resname="ImplementationGuide.definition.resource.name">
             <notes>
               <note id="n1">ImplementationGuide.definition.resource.name</note>
             </notes>
        <source>MII CS Medikation Wirkstofftyp</source>
        <target></target>
      </trans-unit>
      <trans-unit id="ImplementationGuide-mii-ig-medikation" resname="ImplementationGuide.definition.resource.description">
             <notes>
               <note id="n1">ImplementationGuide.definition.resource.description</note>
             </notes>
        <source>Codes zur Differenzierung von Wirkstoffen zwischen genauer Substanz (z.B. Salz, Ester etc.), allgemeiner (normalisierter) Substanz und Kombinationscode für mehrere Wirkstoffe.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="ImplementationGuide-mii-ig-medikation" resname="ImplementationGuide.definition.resource.name">
             <notes>
               <note id="n1">ImplementationGuide.definition.resource.name</note>
             </notes>
        <source>MII EX Medikation Wirkstoffrelation</source>
        <target></target>
      </trans-unit>
      <trans-unit id="ImplementationGuide-mii-ig-medikation" resname="ImplementationGuide.definition.resource.description">
             <notes>
               <note id="n1">ImplementationGuide.definition.resource.description</note>
             </notes>
        <source>Die Extension ermöglicht die Zuordnung von einem genauem Wirkstoff (z.B. Salz, Ester) zu einem allgemeinem Wirkstoff.</source>
        <target></target>
      </trans-unit>
      <trans-unit id="ImplementationGuide-mii-ig-medikation" resname="ImplementationGuide.definition.resource.name">
             <notes>
               <note id="n1">ImplementationGuide.definition.resource.name</note>
             </notes>
        <source>MII EX Medikation Wirkstofftyp</source>
        <target></target>
      </trans-unit>
      <trans-unit id="ImplementationGuide-mii-ig-medikation" resname="ImplementationGuide.definition.resource.description">
             <notes>
               <note id="n1">ImplementationGuide.definition.resource.description</note>
             </notes>
        <source>Extension zur Differenzierung des Wirkstofftyps in allgemeinen, genauen oder Kombinationswirkstoff.</source>
        <target></target>
      </trans-unit>
